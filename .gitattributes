# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Python
*.py text eol=lf

# JavaScript / TypeScript / React
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Exclude large binary files from text diffs
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
